# Copy to .env and fill in. .env is gitignored — never commit real keys.

# From https://aistudio.google.com
GEMINI_API_KEY=
# Check the current Flash model name in AI Studio before the hackathon
GEMINI_MODEL=

# Silent duress alert (e.g. a Discord channel webhook)
ALERT_WEBHOOK_URL=

# WebAuthn: must match the origin you open in the browser (use the SSH tunnel)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8000
