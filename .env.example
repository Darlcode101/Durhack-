# Copy to .env ON THE UNO Q and fill in. .env is gitignored — never commit real keys.

# On-device duress model (Edge Impulse). Export the "Linux (AARCH64)" .eim build and copy it to the board.
# With no model the system falls back to the dashboard's own body score, then fails closed.
# The generic model (trained in Studio on synthetic data) is installed per user with `main.py import-model`.
# Encrypted profiles live here (default app/python/profile/).
PROFILE_DIR=
# Anomaly score that counts as "unusual" (the duress score is 0.5 here, 1.0 at twice it)
EI_ANOMALY_LIMIT=1.0
EI_DURESS_LABEL=duress

# Silent duress alert (e.g. a Discord channel webhook)
ALERT_WEBHOOK_URL=

# FIDO2 relying-party ID the YubiKey credential is bound to. Don't change after enrolling.
FIDO_RP_ID=yuduino.local

# Only needed if your YubiKey has a FIDO2 PIN set and insists on it
YUBIKEY_FIDO_PIN=

# Encrypted key store (lives only on the UNO Q)
KEYSTORE_PATH=

# YuSeal: where the board keeps its state; and where the reference verifier (verify_cli.py) keeps its own
DEVICE_STATE=
VERIFIER_STATE=

# The dashboard's local store (one SQLite file on the board; nothing leaves the device)
STORE_PATH=
