# Secrets — never commit
.env
*.pem
*.key

# Generated on the UNO Q: encrypted key store, public keys, audit log
keystore.json
keystore.json.tmp
verifier_keys.json
audit.log

# Captured frames / sensor recordings (contain people's faces)
captures/
recordings/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
.vscode/

# YuSeal provisioning output: device secrets and the verifier's shared tag key
tools/out/
app/sketch/secrets.h
verifier_state.json
device.json

# Face model for the dashboard (downloaded by app/dashboard/restart.sh)
app/dashboard/models/

# The dashboard's local store
app/dashboard/data/

# Encrypted per-user profiles
app/python/profile/

# Demo wallet state (board only)
app/wallet/wallet_state.json
app/wallet/.device_demo.json

# Device secrets: never commit a copy anywhere (e.g. copied next to a bring-up sketch)
**/secrets.h

